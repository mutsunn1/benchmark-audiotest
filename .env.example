# Copy to `.env` and fill in. `.env` is gitignored; never commit the key.
#
# The pipeline runs fully offline without any of this (`--tts say --scorers
# traditional`). A key is only needed for the Qwen TTS corpus and the Qwen-Omni
# scorer.

# --- credentials ---------------------------------------------------------
DASHSCOPE_API_KEY=sk-replace-me

# --- endpoints -----------------------------------------------------------
# Mainland China (default). For the Singapore region use:
#   https://dashscope-intl.aliyuncs.com/api/v1
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_COMPAT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- models --------------------------------------------------------------
# Text to speech. `voice` reads the learner takes, `teacher_voice` the model
# pronunciation the learner is compared against - they must differ, or the
# comparison degenerates into matching a recording against itself.
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
QWEN_TTS_TEACHER_VOICE=Ethan

# Omni model used as the scoring baseline.
QWEN_OMNI_MODEL=qwen3-omni-flash

# --- paths and limits ----------------------------------------------------
CAPTBENCH_DATA_DIR=data
CAPTBENCH_TIMEOUT=120
